# Copy to .env (or run: bash scripts/make-env.sh). Never commit .env.
# Letters and numbers only in passwords.

# --- OpenAI ---------------------------------------------------------------
# Endpoint: OpenAI, or any OpenAI-compatible gateway (e.g. Open WebUI: https://<host>/api)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-REPLACE_ME
# Default model; switch any time with 'models' / 'model <id>' or the web UI sidebar
OPENAI_MODEL=gpt-5-mini
# Corporate CA bundle for HTTPS to the gateway (PEM), if needed
# SSL_CERT_FILE=/path/to/company-ca.pem

# Which models count as EXTERNAL (data leaves your network). OpenAI is external.
# EXTERNAL_MODEL_PATTERNS=internet/*,zcloud/*
# LLM_PROVIDER_EXTERNAL=           # true/false to override the automatic check
# Lab only: let these databases use external models anyway (never for real prod).
# Home lab with OpenAI: uncomment this, or oracle_prod answers "Blocked".
# ALLOW_EXTERNAL_MODELS_FOR=oracle_prod

# --- Agent ----------------------------------------------------------------
# single = you choose one database at a time (default); auto = agent routes
AGENT_MODE=single
# Optional: start on this database without the menu (postgres|mysql|mariadb|oracle_prod)
DEFAULT_DATABASE=

# --- PostgreSQL (shop) ----------------------------------------------------
POSTGRES_USER=toolbox_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop_db
DB_READER_PASSWORD=change-me

# --- MySQL (inventory) ----------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_READER_PASSWORD=change-me

# --- MariaDB (support) ----------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me
MARIADB_READER_PASSWORD=change-me

# --- Oracle 19c lab (Data Guard primary + standby) ------------------------
# Built from your image by docker compose (profile oracle-lab). Needs ~8 GB RAM.
ORACLE_IMAGE=oracle/database:19.3.0-ee-ext
ORACLE_SYS_PASSWORD=change-me
# ORACLE_SGA_MB=1536
# ORACLE_PGA_MB=512
# localhost ports for SQL*Plus / SQL Developer (1521/1522 stay free for other databases)
# ORACLE_PRIMARY_PORT=1531
# ORACLE_STANDBY_PORT=1532

# --- Oracle PROD (oracle_prod in the agent) --------------------------------
# Default: the lab primary above. For your real primary: <host-or-scan>:<port>/<service>
# Leave it empty (and drop the profiles below) to switch oracle_prod off.
ORACLE_PROD_CONNECTION_STRING=oracle-primary:1521/ORCLCDB.localdomain
ORACLE_PROD_USERNAME=C##AGENT_READER
# The lab primary creates C##AGENT_READER with this password
ORACLE_PROD_PASSWORD=change-me

# Which optional parts docker compose starts
COMPOSE_PROFILES=oracle-lab,oracle-prod

# --- MCP Toolbox ----------------------------------------------------------
TOOLBOX_VERSION=latest
